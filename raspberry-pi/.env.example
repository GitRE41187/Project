# Copy this file to .env and fill in the values for your environment.

# URL of the ASP.NET backend server (must be reachable from this Pi)
# Example: http://192.168.1.12:5000
SERVER_URL=http://<BACKEND_HOST>:5000

# Robot identity (must match what's registered in the backend DB)
ROBOT_CAR_ID=robot-001
ROBOT_CAR_NAME=Alpha Bot

# Freenove motor/ADC library path (required for wheels to move)
# EXTRA_PYTHONPATH=/home/huntrix/Freenove_4WD_Smart_Car_Kit_for_Raspberry_Pi/Code/Server

# Return home — recommended for learning / trial-and-error:
# RETURN_HOME_ON_STOP=true
# RETURN_HOME_MODE=hybrid
#   hybrid: (line if enabled) → short/straight → direct, U/S/messy paths → retrace
#   line:   reverse along the field line with the IR sensors, fallback retrace
# ODOMETRY_TURN_RATE=3.5
# ODOMETRY_TURN_SCALE=1.2
# ODOMETRY_TURN_SPEED=1800
# ODOMETRY_TURN_SETTLE=0.4
# Optional hybrid knobs:
# HYBRID_MAX_TURN_SEGMENTS=2
# HYBRID_MAX_MOVE_TIME=4.0
# HYBRID_MAX_DIST_M=1.2
# HYBRID_MAX_YAW_DEG=60

# Line-following return (หมุน 180° แล้วตามเส้นเดินหน้ากลับ)
# hybrid จะลองโหมดนี้เองเมื่อสคริปต์อ่านเซ็นเซอร์ IR — ตั้ง true เพื่อบังคับให้ลองทุกครั้ง:
# RETURN_HOME_LINE_FIRST=false
# LINE_IR_LEFT=14
# LINE_IR_MIDDLE=15
# LINE_IR_RIGHT=23
# LINE_RETURN_SPEED=650
# LINE_RETURN_TURN_SPEED=900
# LINE_RETURN_PIVOT_SPEED=1500
# LINE_RETURN_MAX_SECS=30
# LINE_RETURN_IGNORE_PAD_SECS=2.0
# LINE_RETURN_PAD_HOLD=1.0
# LINE_RETURN_LOST_GIVE_UP=2.5
# LINE_RETURN_NO_FALLBACK_AFTER=2.5
# LINE_RETURN_UTURN_SECS=0        # 0 = คำนวณจาก ODOMETRY_TURN_RATE/SCALE
# LINE_RETURN_UTURN_DIR=left      # left หรือ right

# Local Flask health-check port (default: 5001)
# ROBOT_CAR_PORT=5001
