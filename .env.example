# Database — ใช้เป็นอ้างอิง (backend อ่านค่าจาก appsettings ใน repo นี้)
# Connection string มาตรฐาน Npgsql: Host=...;Port=5432;Database=field_control;Username=...;Password=...;
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=field_control

# Raspberry Pi - ชี้ไปที่ Backend ASP.NET
# SERVER_URL=http://<IP-ของเครื่องที่รัน-backend>:5000
