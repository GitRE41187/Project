# Database — เก็บค่าจริงใน .env (ไม่ commit) หรือตั้งใน appsettings / User Secrets
# รูปแบบ Npgsql: Host=...;Port=5432;Database=field_control;Username=...;Password=...;
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=field_control

# Raspberry Pi - ชี้ไปที่ Backend ASP.NET
# SERVER_URL=http://<IP-ของเครื่องที่รัน-backend>:5000
SERVER_URL=http://127.0.0.1:5000
ROBOT_CAR_ID=robot-001
ROBOT_CAR_NAME=Alpha Bot
# ROBOT_CAR_IP=192.168.1.50
ROBOT_CAR_PORT=5001
# Alias เดิมที่ยังรองรับ: PORT=5001
# ขนาด body สูงสุดสำหรับ base64 upload จาก backend (ไบต์)
# MAX_CONTENT_LENGTH=15728640
